// MONTRA — Customer Receipt & Order Management
// Prisma schema. Postgres (Neon). Money stored as Decimal(12,2) in LKR.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (PgBouncer) for app queries
  directUrl = env("DIRECT_URL") // direct for migrations
}

// ----------------------------- Enums -----------------------------
enum Role {
  ADMIN
  STAFF
  // A pattern maker only ever sees the Styles section — enforced by
  // ROLE_SECTIONS in src/lib/section-access.ts, which intersects a user's
  // role with whatever their business's plan allows. Unlike ADMIN/STAFF
  // (who see everything the plan includes), this role is deliberately
  // narrow: an outside contractor who uploads patterns and nothing more.
  PATTERN_MAKER
}

enum ReceiptStatus {
  DRAFT
  FINALIZED
}

// Production workflow stages an order moves through after the receipt is finalized.
enum OrderStatus {
  FABRIC_SELECTION
  CUTTING
  PRODUCTION
  QUALITY_CHECK
  IRON_PACKING
  DELIVERY
  // Terminal stage, past Delivery — set automatically at creation when a
  // receipt (e.g. from a bulk-upload review) is already fully paid, since
  // that's a strong signal the whole order is already done. Can also be set
  // manually like any other stage.
  COMPLETED
}

// Payment progress, derived from amounts paid vs. total due.
enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

// Bulk (normal multi-unit) vs Sample (single-unit development for QC).
// A sample can be converted to bulk, or deleted if the customer rejects it.
enum OrderType {
  BULK
  SAMPLE
}

// Which top-level folder (Men's / Women's) a receipt files under, both
// in-app and in the synced computer folder.
enum Category {
  MEN
  WOMEN
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum AuditAction {
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  RECEIPT_CREATED
  RECEIPT_UPDATED
  RECEIPT_FINALIZED
  PDF_GENERATED
  ORDER_STATUS_CHANGED
  VERSION_CREATED
  PAYMENT_RECORDED
  RECEIPT_DELETED
  CUSTOMER_DELETED
  EXPENSE_RECORDED
  EXPENSE_DELETED
  EXPENSE_UPDATED
  EXPENSE_FINALIZED
  EXPENSE_UNFINALIZED
  BUSINESS_REGISTERED
  BUSINESS_UPDATED
  BUSINESS_LOGO_UPDATED
  BUSINESS_API_KEY_UPDATED
  STAFF_INVITE_CREATED
  STAFF_INVITE_REVOKED
  STAFF_INVITE_REDEEMED
  ORDER_CONFIRMED
  BUSINESS_PLAN_CHANGED
  BUSINESS_SUBSCRIPTION_STATUS_CHANGED
  PATTERN_CREATED
  PATTERN_ASSIGNED
  PATTERN_UNASSIGNED
  PATTERN_FINALIZED
  PATTERN_DELETED
  INVENTORY_PRODUCT_CREATED
  INVENTORY_PRODUCT_UPDATED
  INVENTORY_PRODUCT_ARCHIVED
  INVENTORY_STOCK_ADJUSTED
  INVENTORY_SALE_RECORDED
  INVENTORY_CATEGORY_CREATED
  INVENTORY_CATEGORY_UPDATED
  INVENTORY_CATEGORY_DELETED
  INVENTORY_RETURN_PROCESSED
  COD_SALE_CREATED
  COD_CONFIRMED
  COD_DISPATCHED
  COD_DELIVERED
  COD_REFUSED
  COD_CANCELLED
  COD_SETTLED
}

// A gate-able dashboard section — used by Plan.enabledSections to control
// what a business can see/use. Deliberately whole-section granularity, not
// finer per-action flags (e.g. "can create receipts but not delete them").
enum Section {
  CUSTOMERS
  RECEIPTS
  ORDERS
  PRODUCTION
  EXPENSES
  INCOME
  STYLES
  RECOMMENDATIONS
  TEAM
  AUDIT_LOG
  SETTINGS
  // Retail sections — see SECTION_GROUPS in src/lib/sections.ts, which is
  // what actually splits the dashboard nav into a Wholesale group
  // (everything above) and a Retail group (these).
  INVENTORY
  SALES
}

// Local (Sri Lanka) vs Global — the two lenses the Recommendations section
// presents fashion-trend data through.
enum TrendRegion {
  LOCAL
  GLOBAL
}

// ACTIVE/TRIAL both count as "in good standing" (full plan access); EXPIRED
// and CANCELLED both drop a business to zero sections regardless of its
// plan — see getBusinessAccess() in src/lib/section-access.ts. No payment
// provider wired up yet: a Super Admin sets this by hand for now (see
// Business.subscriptionStatus) — real billing can flip it automatically later
// without any of the enforcement code needing to change.
enum SubscriptionStatus {
  ACTIVE
  TRIAL
  EXPIRED
  CANCELLED
}

// A named bundle of enabled sections — e.g. "Full Access", or a future
// "Basic"/"Pro" tier. Businesses are assigned one by a Super Admin (see
// Business.planId). Changing a plan's sections instantly changes access for
// every business on that plan.
model Plan {
  id             String    @id @default(cuid())
  name           String    @unique
  enabledSections Section[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  businesses Business[]
}

// ----------------------------- Users -----------------------------
// Mirror of the Clerk user. We never trust the client for identity —
// the Clerk session is the source of truth; this row caches display info.
// Role is no longer here — a person's role can differ per business (e.g.
// Admin of their own business, Staff if invited into someone else's), so it
// lives on BusinessMember instead.
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  // Platform-level role, unrelated to any business membership — can manage
  // every business's plan/subscription and customize what sections exist at
  // all. Never settable via any UI/API; only ever flipped by hand in the
  // database. See requireSuperAdmin() in lib/auth.ts.
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Which business this user is currently acting within. Only meaningful to
  // read once a membership row confirms they still belong to it — see
  // requireBusiness() in lib/auth.ts.
  activeBusinessId String?
  activeBusiness   Business? @relation("ActiveBusiness", fields: [activeBusinessId], references: [id], onDelete: SetNull)

  memberships         BusinessMember[]
  staffInvitesCreated StaffInvite[]        @relation("StaffInviteCreatedBy")
  staffInvitesUsed    StaffInvite[]        @relation("StaffInviteUsedBy")
  createdReceipts     Receipt[]            @relation("ReceiptCreatedBy")
  finalizedReceipts   Receipt[]            @relation("ReceiptFinalizedBy")
  versions            ReceiptVersion[]
  orderChanges        OrderStatusHistory[]
  auditLogs           AuditLog[]
  customerInvites     CustomerInvite[]
  payments            Payment[]
  patternsCreated     Pattern[]            @relation("PatternCreatedBy")
  patternsFinalized   Pattern[]            @relation("PatternFinalizedBy")
  expenseRecords      ExpenseRecord[]      @relation("ExpenseRecordedBy")
  finalizedExpenses   ExpenseRecord[]      @relation("ExpenseFinalizedBy")
  inventoryProductsCreated InventoryProduct[]       @relation("InventoryProductCreatedBy")
  stockMovementsPerformed InventoryStockMovement[] @relation("StockMovementPerformedBy")
  inventorySales           InventorySale[]
  inventoryReturnsProcessed InventoryReturn[]
  codSettlementsCreated    CodSettlement[]
}

// ---------------------------- Business ----------------------------
// A tenant. Every Customer/Receipt/CustomerInvite/AuditLog belongs to
// exactly one — see requireBusiness() for how the active one is resolved
// per request.
model Business {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  // Where transactional notifications go (currently: a customer completing
  // self-registration via an invite link). Deliberately its own field rather
  // than reusing admin members' addresses — those come from Clerk and can be
  // placeholders that hard-bounce, and the right recipient is often a shared
  // inbox rather than one person. Null disables notifications for this business.
  notificationEmail String?
  // Encrypted (see src/lib/crypto/secret-box.ts) — a business's own Gemini
  // API key for the receipt-photo OCR import, so heavy usage on one tenant
  // doesn't exhaust the shared default key's free-tier quota for everyone
  // else. Null means "use the shared default key".
  geminiApiKeyEncrypted String?
  // Per-business invoice-number counters. Each business's numbers start at 1
  // and increment independently of every other business's. Only incremented
  // when a receipt is actually confirmed (see Receipt.receiptNumber), so
  // abandoned/never-paid receipts never burn a number.
  //
  // Bulk and Sample orders run as two SEPARATE sequences — Bulk #1 and
  // Sample #1 can both exist and are different orders (told apart by the
  // "S-" prefix Samples display/file under; see lib/utils/receipt-number.ts).
  // lastReceiptNumber is the BULK counter, keeping its original name so
  // existing bulk invoices keep their exact numbering with no renumbering.
  lastReceiptNumber Int      @default(0)
  lastSampleNumber  Int      @default(0)

  // Retail Cash-on-Delivery (see InventorySaleDelivery). Opt-in per business
  // so the COD option only shows up for businesses that deliver parcels.
  // lastDispatchNumber is the atomic counter behind "COD-0042" references.
  // codRefusalWarnThreshold: how many earlier REFUSED COD orders on the same
  // phone number it takes to show the "frequent refuser" warning.
  codEnabled              Boolean @default(false)
  codRefusalWarnThreshold Int     @default(2)
  lastDispatchNumber      Int     @default(0)

  // Entitlements: which plan this business is on (controls which sections it
  // can see/use — see getBusinessAccess()) and whether its subscription is
  // currently in good standing. No payment provider yet — a Super Admin sets
  // both by hand for now.
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  subscriptionRenewsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         BusinessMember[]
  staffInvites    StaffInvite[]
  activeForUsers  User[]           @relation("ActiveBusiness")
  customers       Customer[]
  receipts        Receipt[]
  patterns        Pattern[]
  customerInvites CustomerInvite[]
  auditLogs       AuditLog[]
  recommendations Recommendation[]
  inventoryProducts   InventoryProduct[]
  inventoryCategories InventoryCategory[]
  stockMovements      InventoryStockMovement[]
  inventorySales      InventorySale[]
  inventoryReturns    InventoryReturn[]
  codDeliveries       InventorySaleDelivery[]
  codSettlements      CodSettlement[]
}

// Membership + role, per business — a person can belong to more than one.
model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @default(STAFF)
  createdAt  DateTime @default(now())

  @@unique([businessId, userId])
  @@index([userId])
}

// Single-use, expiring invite links for bringing staff into a business —
// same shape as CustomerInvite, generalized for team members instead.
model StaffInvite {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  token       String    @unique
  role        Role      @default(STAFF)
  usedAt      DateTime?
  usedById    String?
  usedBy      User?     @relation("StaffInviteUsedBy", fields: [usedById], references: [id])
  expiresAt   DateTime?
  createdById String
  createdBy   User      @relation("StaffInviteCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([token])
  @@index([businessId])
}

// --------------------------- Customers ---------------------------
model Customer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  phone      String?
  // A second/alternate contact number — some customers give two. Purely for
  // staff reachability; not snapshotted onto receipts or printed on the PDF
  // (those stay as they are, keyed off the primary phone only).
  otherPhone String?
  email      String?
  nic        String? // NIC / identification number
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  receipts Receipt[]
  invite   CustomerInvite?

  @@index([businessId])
  @@index([name])
  @@index([phone])
  @@index([otherPhone])
  @@index([email])
  @@index([createdAt])
}

// ----------------- Customer self-registration invites -----------------
// One-time tokenized links sent to a prospective customer so they fill in
// their own details. A token is single-use (usedAt) and time-limited
// (expiresAt). Sharing a spent link can't create more customers.
model CustomerInvite {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  token      String    @unique
  usedAt     DateTime?
  expiresAt  DateTime?

  // The customer this invite produced, once submitted.
  customerId String?   @unique
  customer   Customer? @relation(fields: [customerId], references: [id])

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([businessId])
  @@index([token])
}

// ---------------------------- Receipts ---------------------------
model Receipt {
  id String @id @default(cuid())
  // Null until confirmed (see receiptService — a new BULK order with no
  // payment yet stays "Unconfirmed" and never gets a number until the advance
  // is paid). Unique per business AND per orderType, not globally — Bulk and
  // Sample are two independent sequences, so Bulk #1 and Sample #1 are
  // different orders that legitimately coexist (see Business.lastSampleNumber).
  receiptNumber Int?

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Snapshot of customer fields at issue time (so edits to the customer
  // record never silently rewrite a finalized document).
  custName    String
  custAddress String?
  custPhone   String?
  custEmail   String?

  date  DateTime @default(now())
  notes String?

  // Customer-facing conditions printed on the receipt itself (e.g. "no
  // exchanges", a rush-order surcharge note) — distinct from `notes`, which
  // is staff-only and never appears on the PDF.
  specialNotes String?

  // Payment information block (the four boxes on the template)
  paymentMethods PaymentMethod[]

  // Monetary fields (LKR). Derived in the service layer, persisted for fast reads.
  subtotal         Decimal @default(0) @db.Decimal(12, 2)
  adjustmentsTotal Decimal @default(0) @db.Decimal(12, 2)
  totalDue         Decimal @default(0) @db.Decimal(12, 2)
  advanceAmount    Decimal @default(0) @db.Decimal(12, 2)
  amountPaid       Decimal @default(0) @db.Decimal(12, 2)
  balance          Decimal @default(0) @db.Decimal(12, 2)

  status        ReceiptStatus @default(DRAFT)
  orderStatus   OrderStatus   @default(FABRIC_SELECTION)
  paymentStatus PaymentStatus @default(UNPAID)
  orderType     OrderType     @default(BULK)
  category      Category      @default(WOMEN)

  // Permanent public tracking-page token — set only for BULK orders (null
  // for SAMPLE). Never expires; customers use it to check production status.
  trackingToken String? @unique

  currentVersion Int       @default(1)
  finalizedAt    DateTime?
  finalizedById  String?
  finalizedBy    User?     @relation("ReceiptFinalizedBy", fields: [finalizedById], references: [id])

  createdById String
  createdBy   User   @relation("ReceiptCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sample→bulk conversion link. Set on a SAMPLE when "Convert to Bulk" runs,
  // pointing at the BULK receipt it produced; null means not yet converted.
  // 1:1 (@unique) — a bulk comes from at most one sample, and a sample
  // converts to at most one bulk. onDelete: SetNull so deleting the bulk just
  // marks the sample un-converted again rather than cascading.
  convertedToBulkId   String?  @unique
  convertedToBulk     Receipt? @relation("SampleConversion", fields: [convertedToBulkId], references: [id], onDelete: SetNull)
  convertedFromSample Receipt? @relation("SampleConversion")

  items         ReceiptItem[]
  adjustments   ReceiptAdjustment[]
  versions      ReceiptVersion[]
  orderHistory  OrderStatusHistory[]
  payments      Payment[]
  expenseRecord ExpenseRecord?

  @@unique([businessId, orderType, receiptNumber])
  @@index([status])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([orderType])
  @@index([customerId])
  @@index([createdAt])
}

// ------------------------- Payment ledger ------------------------
// One row per instalment recorded against a finalized receipt. The
// receipt's amountPaid is kept as the running sum of these entries;
// paymentStatus is recomputed from total paid vs. totalDue.
model Payment {
  id           String         @id @default(cuid())
  receiptId    String
  receipt      Receipt        @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  amount       Decimal        @db.Decimal(12, 2)
  method       PaymentMethod?
  note         String?
  paidAt       DateTime       @default(now())
  recordedById String
  recordedBy   User           @relation(fields: [recordedById], references: [id])
  createdAt    DateTime       @default(now())

  @@index([receiptId])
}

// ------------------------- Expense ledger -------------------------
// One structured cost record per receipt (fabric/sewing/accessory/other).
// Profit is stored (auto-calculated client-side, but overridable) rather
// than always recomputed, so a manual override survives. Only finalized
// records are picked up by the Income/P&L page — unfinalized ones are
// invisible there until an admin locks them in.
model ExpenseRecord {
  id        String  @id @default(cuid())
  receiptId String  @unique
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  // Bulk orders track all six; Sample orders only use fabric/patternMaking/
  // production — the other three simply stay 0 and unedited for a sample.
  fabricExpense        Decimal @default(0) @db.Decimal(12, 2)
  patternMakingExpense Decimal @default(0) @db.Decimal(12, 2)
  cuttingExpense       Decimal @default(0) @db.Decimal(12, 2) // Bulk only
  productionExpense    Decimal @default(0) @db.Decimal(12, 2)
  accessoryExpense     Decimal @default(0) @db.Decimal(12, 2) // Bulk only
  otherExpense         Decimal @default(0) @db.Decimal(12, 2) // Bulk only

  profit Decimal @default(0) @db.Decimal(12, 2)

  finalized     Boolean   @default(false)
  finalizedAt   DateTime?
  finalizedById String?
  finalizedBy   User?     @relation("ExpenseFinalizedBy", fields: [finalizedById], references: [id])

  recordedById String
  recordedBy   User     @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([finalized])
}

model ReceiptItem {
  id          String  @id @default(cuid())
  receiptId   String
  receipt     Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  // Production tracking is per item, not per receipt — an order's overall
  // status (on Receipt) is a cached rollup of these.
  orderStatus OrderStatus          @default(FABRIC_SELECTION)
  history     OrderStatusHistory[]

  // Which pattern (style) this item is made from, assigned by an admin from
  // the Production page. Nullable: most items have none until assigned. Not
  // unique — one pattern is deliberately reusable across many order items,
  // which is the whole point of a pattern. onDelete: SetNull so removing a
  // pattern never cascades into deleting live order items.
  patternId String?
  pattern   Pattern? @relation(fields: [patternId], references: [id], onDelete: SetNull)

  @@index([receiptId])
  @@index([patternId])
}

// A style/pattern uploaded by a Pattern Maker, later assigned to order items.
// patternCode is the human-facing "Pattern ID" that gets read aloud and typed
// by hand into the Assign Pattern dialog — system-generated, never chosen.
// PENDING_REVIEW = uploaded by a pattern maker, awaiting an admin's
// description/picture. FINALIZED = reviewed and assignable to order items.
enum PatternStatus {
  PENDING_REVIEW
  FINALIZED
}

model Pattern {
  id         String @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // The human-facing "Pattern ID". Derived from the uploaded module file's
  // name (e.g. "EC 1.mdl" → "EC 1"), not typed. Unique per business (not
  // globally). Stored normalized (trimmed + uppercased) so case variants can't
  // become near-duplicates; see normalizePatternCode() / patternCodeFromFileName().
  patternCode String
  // Two-stage lifecycle: the pattern maker bulk-uploads .mdl files (created
  // PENDING_REVIEW, with no description/picture yet); an admin then reviews
  // each, adds a description (+ optional picture) and FINALIZEs it. Only
  // FINALIZED patterns can be assigned to order items.
  status PatternStatus @default(PENDING_REVIEW)
  // Null until an admin reviews the pattern (required to finalize).
  description String?
  // Optional reference photo (admin adds at review), plus the required Module
  // (.mdl) file. Any file type is accepted for the module, so it's never
  // assumed to be renderable as an <img>. Nullable at the DB level (older rows
  // / pre-review state); the app enforces the module on upload.
  imageUrl       String?
  moduleFileUrl  String?
  // Original upload filename — Blob URLs are opaque, so without this there'd be
  // nothing meaningful to label the download link with.
  moduleFileName String?

  createdById String
  createdBy   User   @relation("PatternCreatedBy", fields: [createdById], references: [id])
  // Which admin finalized it, and when (null while PENDING_REVIEW).
  finalizedById String?
  finalizedBy   User?     @relation("PatternFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)
  finalizedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ReceiptItem[]

  @@unique([businessId, patternCode])
  @@index([businessId])
  @@index([createdById])
}

// --------------------------- Inventory (Retail) ---------------------------
// The Retail counterpart to Styles/Pattern above: a self-contained module
// gated on its own Section (INVENTORY), grouped under "Retail" in the
// dashboard nav (see SECTION_GROUPS in src/lib/sections.ts). Quantity on hand
// is a denormalized running total — same rationale as Receipt's money
// fields, "derived in the service layer, persisted for fast reads" — and is
// only ever changed via InventoryStockMovement rows, which are the actual
// source of truth for stock history (who changed what, when, and why).
// A business-managed category list — replaces free-text category entry so
// it can be picked from a dropdown and renamed in one place without having
// to touch every product. onDelete: SetNull on the product side means
// deleting a category just clears it off any products that used it, rather
// than blocking the delete or cascading.
model InventoryCategory {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())

  products InventoryProduct[]

  @@unique([businessId, name])
  @@index([businessId])
}

model InventoryProduct {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  sku  String
  name String
  categoryId String?
  category   InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  costPrice    Decimal @default(0) @db.Decimal(12, 2)
  sellingPrice Decimal @default(0) @db.Decimal(12, 2)
  quantityOnHand Int   @default(0)

  // Soft delete — a hard delete would orphan its movement history.
  isArchived Boolean @default(false)

  createdById String
  createdBy   User   @relation("InventoryProductCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movements InventoryStockMovement[]
  saleItems InventorySaleItem[]
  returns   InventoryReturn[]

  @@unique([businessId, sku])
  @@index([businessId])
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

// One row per stock change — the running log a product's "Stock History"
// view reads from. `quantity` is always positive; direction comes from `type`.
model InventoryStockMovement {
  id        String           @id @default(cuid())
  productId String
  product   InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  type     StockMovementType
  quantity Int
  reason   String
  note     String?

  performedById String
  performedBy   User     @relation("StockMovementPerformedBy", fields: [performedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([businessId])
}

// A manually-recorded retail sale transaction — can cover several products
// in one basket (see InventorySaleItem below), same header+lines shape as
// Receipt/ReceiptItem. There's no POS yet, so this is entered by hand; see
// RecordSaleButton. Recording a sale creates this header + its line items
// AND one InventoryStockMovement per line (type OUT, reason "Sold") in the
// same transaction, so the stock ledger and the sales ledger never disagree
// — see sale.service.ts.
model InventorySale {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  totalAmount   Decimal @db.Decimal(12, 2) // sum of item line totals, derived + persisted
  paymentMethod PaymentMethod?
  note          String?

  soldById  String
  soldBy    User     @relation(fields: [soldById], references: [id])
  createdAt DateTime @default(now())

  // IN_STORE (the original, immediate-sale behaviour) or COD_DELIVERY — a
  // parcel collected on delivery, tracked by `delivery` below. A COD sale's
  // stock is reserved when it's created, but it only counts toward Sales
  // revenue/profit once its delivery reaches DELIVERED (see saleService.list).
  fulfilment SaleFulfilment @default(IN_STORE)
  delivery   InventorySaleDelivery?

  items InventorySaleItem[]

  @@index([businessId])
  @@index([createdAt])
}

enum SaleFulfilment {
  IN_STORE
  COD_DELIVERY
}

// Where a COD sale is in its life. Stock is reserved from PENDING_CONFIRMATION
// onward and restored if it ends REFUSED or CANCELLED; the sale only counts as
// revenue from DELIVERED. REMITTED = the courier has paid us (cash received).
enum CodStatus {
  PENDING_CONFIRMATION // waiting for the customer to confirm via the WhatsApp link
  PENDING_DISPATCH     // confirmed, ready to hand to the courier
  OUT_FOR_DELIVERY
  DELIVERED            // courier collected the cash — a receivable until remitted
  REMITTED             // courier paid us; settled
  REFUSED              // refused / undeliverable; stock restored
  CANCELLED            // cancelled before dispatch; stock restored
}

enum DeliveryFeePayer {
  CUSTOMER // fee is added to the COD amount the courier collects
  BUSINESS // fee is absorbed by the seller and reduces profit
}

// COD data for a sale, kept 1:1 and separate so in-store sales and every query
// that reads them are untouched. businessId is denormalised for tenant-safe
// queries without a join.
model InventorySaleDelivery {
  id         String        @id @default(cuid())
  saleId     String        @unique
  sale       InventorySale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Our own per-business reference ("COD-0042") — NOT the courier's waybill.
  dispatchRef String

  customerName            String
  customerPhone           String
  customerPhone2          String?
  // Digits only, country-code form (94…), so 0771234567 / +94771234567 /
  // "94 77 123 4567" all match — used for the frequent-refuser warning.
  customerPhoneNormalized String
  deliveryAddress         String
  city                    String?

  // The courier is free text (not decided yet); the waybill is issued by the
  // courier and typed in by the seller at dispatch.
  courierName String?
  waybillNo   String?
  codAmount   Decimal          @db.Decimal(12, 2) // what the courier must collect
  deliveryFee Decimal          @default(0) @db.Decimal(12, 2)
  feePaidBy   DeliveryFeePayer @default(CUSTOMER)

  status       CodStatus @default(PENDING_DISPATCH)
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  remittedAt   DateTime?
  closedAt     DateTime? // when it ended REFUSED / CANCELLED
  closedReason String?

  // Customer confirmation link (WhatsApp-assisted flow): 256-bit token,
  // expires, only works while status is PENDING_CONFIRMATION.
  confirmToken     String?   @unique
  confirmExpiresAt DateTime?
  confirmedAt      DateTime?
  confirmedBy      String? // "CUSTOMER" (via link) | "SELLER" (manual)

  settlementId String?
  settlement   CodSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, dispatchRef])
  @@unique([businessId, courierName, waybillNo])
  @@index([businessId, status])
  @@index([businessId, customerPhoneNormalized, status])
  @@index([settlementId])
}

// One courier remittance covering many delivered COD orders.
model CodSettlement {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  courierName String
  reference   String? // bank / courier statement reference
  receivedAt  DateTime

  grossCollected Decimal @db.Decimal(12, 2) // sum of the included orders' COD amounts
  feesDeducted   Decimal @db.Decimal(12, 2)
  netReceived    Decimal @db.Decimal(12, 2) // what actually arrived
  variance       Decimal @db.Decimal(12, 2) // gross - fees - net; non-zero = flag
  note           String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  deliveries InventorySaleDelivery[]

  @@index([businessId, receivedAt])
}

// One product line within a sale. costPriceAtSale is a snapshot: a later
// edit to the product's cost price must never rewrite a past sale's
// historical margin.
model InventorySaleItem {
  id        String        @id @default(cuid())
  saleId    String
  sale      InventorySale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   InventoryProduct @relation(fields: [productId], references: [id])

  quantity        Int
  unitPrice       Decimal @db.Decimal(12, 2)
  costPriceAtSale Decimal @db.Decimal(12, 2)
  lineTotal       Decimal @db.Decimal(12, 2)

  returns InventoryReturn[]

  @@index([saleId])
  @@index([productId])
}

// A (partial or full) return against one sale line — restocks the returned
// quantity via its own InventoryStockMovement (type IN, reason "Returned"),
// same transactional pairing sale.service.ts uses for the OUT side. Kept as
// its own ledger rather than mutating the original InventorySaleItem, so a
// sale's historical record never changes — Sales reporting stays gross, and
// Returns is where net-of-returns activity lives.
model InventoryReturn {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleItemId String
  saleItem   InventorySaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  productId  String
  product    InventoryProduct  @relation(fields: [productId], references: [id])

  quantity     Int
  refundAmount Decimal @db.Decimal(12, 2)
  reason       String
  note         String?

  processedById String
  processedBy   User     @relation(fields: [processedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([businessId])
  @@index([saleItemId])
  @@index([productId])
}

// Free-form +/- lines such as "Pattern" (-6,600 in the sample receipt).
model ReceiptAdjustment {
  id        String  @id @default(cuid())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  label     String
  amount    Decimal @db.Decimal(12, 2) // negative = discount
  sortOrder Int     @default(0)

  @@index([receiptId])
}

// ------------------------ Version history ------------------------
// Every edit to a FINALIZED receipt snapshots the full prior state.
model ReceiptVersion {
  id            String   @id @default(cuid())
  receiptId     String
  receipt       Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  versionNumber Int
  snapshot      Json // full receipt + items + adjustments at this version
  changeSummary String?
  modifiedById  String
  modifiedBy    User     @relation(fields: [modifiedById], references: [id])
  createdAt     DateTime @default(now())

  @@unique([receiptId, versionNumber])
  @@index([receiptId])
}

// --------------------- Order status history ----------------------
// itemId is nullable only because rows created before per-item tracking was
// added are receipt-wide and have no single item to attribute to; every row
// created from here on always has one.
model OrderStatusHistory {
  id          String       @id @default(cuid())
  receiptId   String
  receipt     Receipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  itemId      String?
  item        ReceiptItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String
  changedBy   User         @relation(fields: [changedById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([receiptId])
  @@index([itemId])
}

// ----------------------------- Audit -----------------------------
model AuditLog {
  id         String      @id @default(cuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User        @relation(fields: [actorId], references: [id])
  action     AuditAction
  entityType String // "Customer" | "Receipt" | "Order" ...
  entityId   String
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([businessId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ----------------------- Recommendations -----------------------
// Raw fashion-trend data pulled from SerpApi (Google Trends). SHARED across
// every business — "frock interest in Sri Lanka this month" is the same for
// all of them — so it's fetched once per (region, period) and cached here,
// keeping SerpApi usage tiny. `data` holds the fetched time-series JSON.
model TrendSnapshot {
  id        String      @id @default(cuid())
  region    TrendRegion
  periodKey String // "YYYY-MM" — one snapshot per calendar month per region
  data      Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([region, periodKey])
}

// A business's generated recommendation cards for one region+month. Unlike the
// shared trend data, this is PER business — it blends the shared trends with
// that business's own order history via its Gemini key, so the result is
// tailored. Cached so the LLM runs at most once a month per region.
model Recommendation {
  id         String      @id @default(cuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  region     TrendRegion
  periodKey  String // "YYYY-MM"
  data       Json // the generated cards
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([businessId, region, periodKey])
  @@index([businessId])
}
